{
  "appId": "com.infiniteqgraphics.ferridash",
  "appName": "FerriDash",
  "webDir": "www",
  "appendUserAgent": "FerriDashApp/1.0",
  "backgroundColor": "#0F172A",
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["*"]
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0F172A",
      "showSpinner": false
    }
  }
}
